{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "成员国义务实施事项文档（六要素分解）",
  "type": "object",
  "required": ["member", "version", "updated_at", "tasks"],
  "properties": {
    "member": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "measure_code",
        "article",
        "confirmation",
        "responsible_agencies",
        "legal_amendment",
        "technical_interface",
        "budget",
        "completion_evidence",
        "exemption_id",
        "prerequisites"
      ],
      "properties": {
        "measure_code": { "type": "string", "minLength": 1 },
        "article": { "type": "string", "minLength": 1 },
        "confirmation": { "enum": ["draft", "confirmed"] },
        "responsible_agencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agency_code", "role"],
            "properties": {
              "agency_code": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "legal_amendment": {
          "type": "object",
          "required": ["instrument", "status", "effective_date", "gazette_ref"],
          "properties": {
            "instrument": { "type": ["string", "null"] },
            "status": {
              "enum": ["draft", "in_parliament", "enacted_not_in_force", "in_force"]
            },
            "effective_date": { "type": ["string", "null"], "format": "date" },
            "gazette_ref": { "type": ["string", "null"] },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "technical_interface": {
          "type": "object",
          "required": ["system", "status", "go_live_date", "spec_ref"],
          "properties": {
            "system": { "type": ["string", "null"] },
            "status": { "enum": ["build", "pilot", "uat", "live"] },
            "go_live_date": { "type": ["string", "null"], "format": "date" },
            "spec_ref": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "required": ["status", "line", "amount_local", "currency"],
          "properties": {
            "status": { "enum": ["requested", "partial", "allocated"] },
            "line": { "type": ["string", "null"] },
            "amount_local": { "type": ["number", "null"] },
            "currency": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "completion_evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exemption_id": { "type": ["string", "null"] },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
